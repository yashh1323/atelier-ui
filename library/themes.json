{
  "themes": [
    {
      "id": "editorial-stone",
      "fit": ["place", "service", "product"],
      "vibe": "Warm print editorial with crisp ink contrast and generous measure",
      "tokens": {
        "--bg": "#F6F4EF",
        "--surface": "#ECE8DF",
        "--ink": "#181715",
        "--muted": "#5C5852",
        "--accent": "#B84A27",
        "--accent-ink": "#FFFFFF",
        "--border": "#D8D2C7"
      },
      "fonts": {
        "display": "Instrument Serif, Georgia, serif",
        "body": "Plus Jakarta Sans, system-ui, sans-serif",
        "mono": "JetBrains Mono, monospace"
      },
      "weights": {
        "display": [400],
        "body": [400, 500, 600, 700]
      },
      "radius": "4px",
      "surface": {
        "elevation": "1px solid var(--border)",
        "shadow": "0 1px 2px rgba(24, 23, 21, 0.05)",
        "ease": "cubic-bezier(0.22, 1, 0.36, 1)",
        "focusRing": "2px solid var(--accent)"
      }
    },
